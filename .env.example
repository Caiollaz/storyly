# ---------------------------------------------------------------------------
# Storyly — variáveis de ambiente (todas server-side; sem prefixo NEXT_PUBLIC_)
# Copie para .env.local e preencha. NUNCA commite .env.local.
# ---------------------------------------------------------------------------

# IA — DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sua_chave_deepseek

# Banco de dados — Postgres
DATABASE_URL=postgresql://storyly:storyly@localhost:5432/storyly

# Auth.js (https://authjs.dev)
# Gere o secret com: openssl rand -base64 33
AUTH_SECRET=gere_um_secret
# URL pública da app (usada em prod p/ callbacks e checkout). Em dev pode omitir.
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=seu_google_client_id
AUTH_GOOGLE_SECRET=seu_google_client_secret

# AbacatePay (https://abacatepay.com)
# - Crie um PRODUTO de assinatura (ciclo mensal) e pegue o id.
# - Configure o webhook para: <AUTH_URL>/api/webhooks/abacatepay?webhookSecret=<ABACATEPAY_WEBHOOK_SECRET>
ABACATEPAY_API_KEY=sua_chave_abacatepay
ABACATEPAY_PRO_PRODUCT_ID=id_do_produto_assinatura
ABACATEPAY_WEBHOOK_SECRET=defina_um_segredo_forte
